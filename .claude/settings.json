{
  "permissions": {
    "allow": [
      "mcp__playwright__browser_network_requests",
      "WebFetch(domain:maplibre.org)",
      "WebFetch(domain:cesium.com)",
      "WebFetch(domain:pixijs.download)",
      "WebFetch(domain:doc.babylonjs.com)",
      "WebFetch(domain:pixijs.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "echo '{\"systemMessage\": \"Committing — make sure this was explicitly requested.\"}'"
          }
        ]
      }
    ]
  }
}
